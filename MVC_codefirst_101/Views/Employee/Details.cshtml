@model MVC_codefirst_101.Models.Employee

@{
    ViewBag.Title = "Details";
}

<h2 class="text-primary text-centre">Employee Details</h2>
<table>
    <thead>
        <tr>
            <th>Name</th>
            <th>Address</th>
            <th>
                Salary
            </th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td>
                @Model.Name
            </td>
            <td>
                @Model.Address
            </td>
            <td>
                @Model.Salary
            </td>
        </tr>
</table>

<p>
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) |
    @Html.ActionLink("Back to List", "Index")
</p>
